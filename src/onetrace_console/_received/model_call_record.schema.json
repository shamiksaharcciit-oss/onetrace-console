{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "model-call-record/1.0",
 "title": "model-call-record/1.0",
 "description": "The model-call record, version 1.0: one model call, one canonical JSON document, an output artifact of the calling stage. Specified in docs/model-call-record.md. Every scalar is a string. Every field that describes the call is a value object in one of five states ($defs/state); a field the writer cannot fill is not observed or not applicable, with its reason in source, never left out and never given a default. The optional `steps` member is the digest of a separate model-generated per-step capture output; the record itself holds no token id and no text. x-groups groups the fields for a reader; x-most-bytes bounds the record's size. The validation keywords are the reader's applied set only.",
 "type": "object",
 "required": [
  "format",
  "call.kind",
  "call.api",
  "credential",
  "model.requested",
  "model.reported",
  "model.files_digest",
  "tokenizer.digest",
  "provider.fingerprint",
  "engine.name",
  "engine.version",
  "runtime.torch",
  "runtime.cuda",
  "runtime.gpu_name",
  "runtime.driver",
  "runtime.compute_capability",
  "dtype",
  "attention_backend",
  "batch.size",
  "batch.executed_size",
  "batch.padded_width",
  "batch.position",
  "batch.members",
  "batch.fillers",
  "batch.batch_invariant",
  "input.token_ids_digest",
  "input.request_digest",
  "output.token_ids_digest",
  "output.text_digest",
  "output.finish",
  "fingerprints"
 ],
 "properties": {
  "format": {
   "const": "model-call-record/1.0",
   "description": "Written by the writer: this version's constant."
  },
  "call.kind": {
   "enum": [
    "self-hosted",
    "hosted"
   ],
   "description": "self-hosted or hosted."
  },
  "call.api": {
   "type": "string",
   "description": "vLLM: vllm.LLM.generate. transformers: model.forward (prefill) or the writer's decode loop. Hosted: the endpoint path, without query string or host credentials."
  },
  "credential": {
   "enum": [
    "present",
    "absent"
   ],
   "description": "present if a key was passed. Never the key, its digest or any part of it."
  },
  "model.requested": {
   "$ref": "#/$defs/vo-string",
   "description": "Declared: the model as the caller asked for it. vLLM: the model argument, as repo@revision for a hub snapshot; transformers: the from_pretrained name and revision; hosted: the request's model field.",
   "x-reasons": {}
  },
  "model.reported": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: the model the engine or the provider reports.",
   "x-reasons": {
    "not observed": {
     "hosted": "the response carries no model field"
    }
   }
  },
  "model.files_digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed: sha256 of the canonical JSON map from file name to file sha256, computed once per loaded engine.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "tokenizer.digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed: the manifest digest of the tokenizer files, computed once per loaded tokenizer.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "provider.fingerprint": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: a build or system fingerprint the provider reports.",
   "x-reasons": {
    "not observed": {
     "hosted": "the response carries none"
    },
    "not applicable": {
     "vllm": "self-hosted: there is no provider",
     "transformers": "self-hosted: there is no provider"
    }
   }
  },
  "engine.name": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: vllm or transformers.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "engine.version": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: the engine's __version__.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "runtime.torch": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: torch in the calling process.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "runtime.cuda": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: torch.cuda in the calling process.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "runtime.gpu_name": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: torch.cuda in the calling process.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "runtime.driver": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: from the NVIDIA management library.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "runtime.compute_capability": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: torch.cuda in the calling process.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "dtype": {
   "$ref": "#/$defs/vo-string",
   "description": "Declared, then observed. vLLM: model_config.dtype; transformers: the parameters' dtype.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "attention_backend": {
   "$ref": "#/$defs/vo-string",
   "description": "Declared, then observed in the calling process. vLLM's worker's own selection is not observed.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "batch.size": {
   "$ref": "#/$defs/vo-integer",
   "description": "Observed. vLLM: the requests submitted together in one generate call; transformers: input_ids.shape[0].",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   },
   "x-batch-gate": true
  },
  "batch.executed_size": {
   "$ref": "#/$defs/vo-integer",
   "description": "Observed. transformers: input_ids.shape[0], the same as batch.size.",
   "x-reasons": {
    "not observed": {
     "vllm": "vLLM does not report per-request step composition (design §1.4)",
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "batch.padded_width": {
   "$ref": "#/$defs/vo-integer",
   "description": "Observed. transformers: input_ids.shape[1].",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    },
    "not applicable": {
     "vllm": "vLLM packs requests without padding (design §1.4)"
    }
   },
   "x-batch-gate": true
  },
  "batch.position": {
   "$ref": "#/$defs/vo-integer",
   "description": "Observed: this request's index in the submitted list, or its row index.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   },
   "x-batch-gate": true
  },
  "batch.members": {
   "$ref": "#/$defs/vo-digests",
   "description": "Observed: for each other request of the batch, in submission order, the digest of its input token ids. Never text, and never token ids.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   },
   "x-batch-gate": true
  },
  "batch.fillers": {
   "$ref": "#/$defs/vo-integer",
   "description": "Observed: how many members are fillers the writer added.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   },
   "x-batch-gate": true
  },
  "batch.batch_invariant": {
   "$ref": "#/$defs/vo-onoff",
   "description": "Declared, then observed in the calling process: vllm.envs and two configuration effects. The engine worker's own state is never claimed.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    },
    "not applicable": {
     "transformers": "transformers has no batch-invariant mode"
    }
   },
   "x-batch-gate": true
  },
  "input.token_ids_digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed: the digest of the prompt token ids the writer passed.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "input.request_digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed, hosted: the digest of the canonical request body, after the credential and every header are removed.",
   "x-reasons": {
    "not applicable": {
     "vllm": "self-hosted: there is no request body",
     "transformers": "self-hosted: there is no request body"
    }
   }
  },
  "output.token_ids_digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed: the digest of the generated token ids.",
   "x-reasons": {
    "not observed": {
     "hosted": "the provider does not expose it (design §1.1: always the case for hosted internals)"
    }
   }
  },
  "output.text_digest": {
   "$ref": "#/$defs/vo-digest",
   "description": "Observed, hosted: the digest of the returned text.",
   "x-reasons": {
    "not applicable": {
     "vllm": "the tokenizer is not run in the engine",
     "transformers": "the tokenizer is not run in the engine"
    }
   }
  },
  "output.finish": {
   "$ref": "#/$defs/vo-string",
   "description": "Observed: the finish reason; hosted, if the response carries it.",
   "x-reasons": {
    "not observed": {
     "hosted": "the response carries no finish reason"
    }
   }
  },
  "fingerprints": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fingerprint"
   },
   "description": "transformers: exact and tolerant over prefill-logits. vLLM: topk_exact and tolerant over first-token-logprobs. Hosted: tolerant over provider-logprobs.",
   "x-reasons": {
    "not observed": {
     "hosted": "the response carries fewer than 16 first-token log-probabilities"
    }
   }
  },
  "steps": {
   "$ref": "#/$defs/vo-digest",
   "description": "Optional: the digest of the per-step capture output model_call.<n>.steps.json, classed model-generated, when a capture level is taken. Absent otherwise. The record never holds a token id or any text; the per-step token ids live in that separate output."
  }
 },
 "patternProperties": {
  "^(engine\\.settings|sampling)\\..+$": {
   "$ref": "#/$defs/vo-string"
  }
 },
 "additionalProperties": false,
 "allOf": [
  {
   "description": "hosted (design §1.3, the Hosted API column): every internal field is not observed, never a value; the request digest is observed; the fingerprint is tolerant over provider-logprobs",
   "if": {
    "properties": {
     "call.kind": {
      "const": "hosted"
     }
    },
    "required": [
     "call.kind"
    ]
   },
   "then": {
    "properties": {
     "model.files_digest": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "tokenizer.digest": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "engine.name": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "engine.version": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "runtime.torch": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "runtime.cuda": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "runtime.gpu_name": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "runtime.driver": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "runtime.compute_capability": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "dtype": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "attention_backend": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.size": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.executed_size": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.padded_width": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.position": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.members": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.fillers": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "batch.batch_invariant": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "input.token_ids_digest": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "output.token_ids_digest": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     },
     "input.request_digest": {
      "properties": {
       "status": {
        "enum": [
         "observed"
        ]
       }
      }
     },
     "provider.fingerprint": {
      "properties": {
       "status": {
        "enum": [
         "observed",
         "not observed"
        ]
       }
      }
     }
    },
    "allOf": [
     {
      "properties": {
       "fingerprints": {
        "items": {
         "properties": {
          "form": {
           "enum": [
            "tolerant"
           ]
          },
          "quantity": {
           "enum": [
            "provider-logprobs"
           ]
          }
         }
        }
       }
      }
     }
    ]
   }
  },
  {
   "description": "self-hosted: no provider, no request body, no returned text, no credential",
   "if": {
    "properties": {
     "call.kind": {
      "const": "self-hosted"
     }
    },
    "required": [
     "call.kind"
    ]
   },
   "then": {
    "properties": {
     "provider.fingerprint": {
      "properties": {
       "status": {
        "enum": [
         "not applicable"
        ]
       }
      }
     },
     "input.request_digest": {
      "properties": {
       "status": {
        "enum": [
         "not applicable"
        ]
       }
      }
     },
     "output.text_digest": {
      "properties": {
       "status": {
        "enum": [
         "not applicable"
        ]
       }
      }
     },
     "credential": {
      "const": "absent"
     }
    }
   }
  },
  {
   "description": "vLLM (design §1.4): no padded width; the executed batch is not reported; topk_exact and tolerant over first-token-logprobs",
   "if": {
    "properties": {
     "call.kind": {
      "const": "self-hosted"
     },
     "engine.name": {
      "properties": {
       "value": {
        "const": "vllm"
       }
      },
      "required": [
       "value"
      ]
     }
    },
    "required": [
     "call.kind",
     "engine.name"
    ]
   },
   "then": {
    "properties": {
     "batch.padded_width": {
      "properties": {
       "status": {
        "enum": [
         "not applicable"
        ]
       }
      }
     },
     "batch.executed_size": {
      "properties": {
       "status": {
        "enum": [
         "not observed"
        ]
       }
      }
     }
    },
    "allOf": [
     {
      "properties": {
       "fingerprints": {
        "items": {
         "properties": {
          "form": {
           "enum": [
            "tolerant",
            "topk_exact"
           ]
          },
          "quantity": {
           "enum": [
            "first-token-logprobs"
           ]
          }
         }
        }
       }
      }
     }
    ]
   }
  },
  {
   "description": "transformers: no batch-invariant mode; exact and tolerant over prefill-logits",
   "if": {
    "properties": {
     "call.kind": {
      "const": "self-hosted"
     },
     "engine.name": {
      "properties": {
       "value": {
        "const": "transformers"
       }
      },
      "required": [
       "value"
      ]
     }
    },
    "required": [
     "call.kind",
     "engine.name"
    ]
   },
   "then": {
    "properties": {
     "batch.batch_invariant": {
      "properties": {
       "status": {
        "enum": [
         "not applicable"
        ]
       }
      }
     }
    },
    "allOf": [
     {
      "properties": {
       "fingerprints": {
        "items": {
         "properties": {
          "form": {
           "enum": [
            "exact",
            "tolerant"
           ]
          },
          "quantity": {
           "enum": [
            "prefill-logits"
           ]
          }
         }
        }
       }
      }
     }
    ]
   }
  }
 ],
 "$defs": {
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "integer": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)$"
  },
  "digests": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^sha256:[0-9a-f]{64}$"
   }
  },
  "onoff": {
   "type": "string",
   "enum": [
    "on",
    "off"
   ]
  },
  "string": {
   "type": "string",
   "minLength": 1
  },
  "vo-digest": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "observed"
      },
      "value": {
       "$ref": "#/$defs/digest"
      },
      "declared": {
       "$ref": "#/$defs/digest"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "declared, not observed"
      },
      "value": {
       "$ref": "#/$defs/digest"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "observed_value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "declared, contradicted"
      },
      "value": {
       "$ref": "#/$defs/digest"
      },
      "observed_value": {
       "$ref": "#/$defs/digest"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "not observed"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "not applicable"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   ]
  },
  "vo-integer": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "observed"
      },
      "value": {
       "$ref": "#/$defs/integer"
      },
      "declared": {
       "$ref": "#/$defs/integer"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "declared, not observed"
      },
      "value": {
       "$ref": "#/$defs/integer"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "value",
      "observed_value",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "const": "declared, contradicted"
      },
      "value": {
       "$ref": "#/$defs/integer"
      },
      "observed_value": {
       "$ref": "#/$defs/integer"
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "status",
      "source"
